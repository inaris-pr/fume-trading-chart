# Fume backend configuration — PLACEHOLDERS ONLY. Never put real values in this file.
#
# Where real values go (see docs/security.md):
#   Local dev:   copy the variables into apps/worker/.dev.vars (gitignored; read by `wrangler dev`).
#   Cloudflare:  `pnpm exec wrangler secret put ALPACA_API_KEY_ID` (and the secret key) from apps/worker/.
#                Non-secret values below are set as `vars` in apps/worker/wrangler.jsonc.
#
# The browser NEVER receives any of these values.

# --- Secrets (Alpaca PAPER account keys; paper and live keys are different) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Non-secret configuration ---
# MVP is paper-only. The backend will refuse to start with any trading host other than paper-api.alpaca.markets.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADING_STREAM_URL=wss://paper-api.alpaca.markets/stream
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Basic plan entitlement: IEX only.
ALPACA_DATA_FEED=iex
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# --- Origin allowlist (NOT authentication; see docs/security.md) ---
# Comma-separated exact origins allowed to call the API/WebSocket from a browser.
# Standalone default: the app's own origin. Local dev example:
FUME_ALLOWED_ORIGINS=http://localhost:5173

# --- Deployed-only (Stage 9): Cloudflare Access verification of the single user ---
# FUME_ACCESS_TEAM_DOMAIN=https://<your-team>.cloudflareaccess.com
# FUME_ACCESS_AUD=

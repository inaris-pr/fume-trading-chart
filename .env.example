# Reference only: Worker configuration, never frontend/VITE_* environment variables.
# Local secrets go in apps/worker/.dev.vars (gitignored); see its empty-value example.
# Production settings go in the explicit Wrangler production environment.
# Production secrets are uploaded only in a separately approved deployment phase.
# See docs/deployment.md. Never put real values for the three secrets in this file.

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
MASSIVE_API_KEY=

# Production example: empty Access/origin values deliberately fail closed.
FUME_ENV=production
FUME_ALLOWED_ORIGINS=
FUME_ACCESS_TEAM_DOMAIN=
FUME_ACCESS_AUD=
# Enable only after written Massive cloud-use authorization and a reviewed release decision.
FUME_MASSIVE_ENABLED=false

ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex
MASSIVE_REST_BASE_URL=https://api.massive.com
MASSIVE_FUTURES_STREAM_URL=wss://delayed.massive.com/futures

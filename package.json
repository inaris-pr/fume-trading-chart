{
  "name": "fume-trading-chart",
  "private": true,
  "description": "Fume: custom Canvas trading chart with provider-neutral market data and brokerage adapters.",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @fume/web dev",
    "build": "pnpm --filter @fume/web build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "~4.1.11"
  }
}
